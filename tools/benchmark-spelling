#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

scratch="$(mktemp -d "${TMPDIR:-/tmp}/keyboop-spelling-eval.XXXXXX")"
trap 'rm -rf "$scratch"' EXIT
sources=(Sources/Keyboop/{WordCompletionIndex,NextWordIndex,PredictionReferenceIndex,PersonalPredictionStore,PredictionDecision,SystemWordRecognizer,SymmetricDeleteIndex,TypoFix,NumericTypoRule,LayoutData,ExtraWords,Keymap,DynamicKeymap}.swift)
swiftc -O -swift-version 5 -module-cache-path "$scratch/modules" \
  "${sources[@]}" Tests/SpellingEval/main.swift -o "$scratch/bench"
KEYBOOP_DATA_DIR="$PWD/Sources/Keyboop/Resources" "$scratch/bench"
