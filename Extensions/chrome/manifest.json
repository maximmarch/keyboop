{
  "manifest_version": 3,
  "name": "Keyboop Site Context",
  "version": "0.5.1",
  "description": "Reports only the active tab domain to Keyboop on macOS for automatic per-site typing rules. Never reads page contents or full URLs.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Keyboop Site Context",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
