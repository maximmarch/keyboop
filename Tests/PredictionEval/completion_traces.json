[
  {"id": "ru-work-01", "group": "ru-work", "text": "Согласуй с бухгалтерией окончате|льную сумму."},
  {"id": "ru-work-02", "group": "ru-work", "text": "В обновлённом догово|ре исправили дату."},
  {"id": "ru-work-03", "group": "ru-work", "text": "На завтрашнем совеща|нии обсудим сроки."},
  {"id": "ru-work-04", "group": "ru-work", "text": "Нам не хватает сведений о поставщи|ке."},
  {"id": "ru-work-05", "group": "ru-work", "text": "Давайте заранее заброни|руем переговорную."},
  {"id": "ru-work-06", "group": "ru-work", "text": "Посмотрите, пожалуйста, прилож|енный файл."},
  {"id": "ru-work-07", "group": "ru-work", "text": "Проект ещё на рассмот|рении комиссии."},
  {"id": "ru-work-08", "group": "ru-work", "text": "Я уточню у руководи|теля на этой неделе."},
  {"id": "ru-work-09", "group": "ru-work", "text": "В заявке нужно указать подразде|ление."},
  {"id": "ru-work-10", "group": "ru-work", "text": "Кто будет ответств|енным за оплату?"},
  {"id": "ru-work-11", "group": "ru-work", "text": "Отправьте участникам напомина|ние в четверг."},
  {"id": "ru-work-12", "group": "ru-work", "text": "Пришлите версию с исправле|ниями."},
  {"id": "ru-work-13", "group": "ru-work", "text": "Удалось ли получить разреш|ение?"},
  {"id": "ru-work-14", "group": "ru-work", "text": "Подготовьте расчёт расхо|дов на квартал."},
  {"id": "ru-work-15", "group": "ru-work", "text": "Перенесём сроки, если не хватит оборудо|вания."},
  {"id": "ru-work-16", "group": "ru-work", "text": "Техническое задание отре|дактировали вчера."},
  {"id": "ru-everyday-01", "group": "ru-everyday", "text": "Купи, пожалуйста, карто|шку и лук."},
  {"id": "ru-everyday-02", "group": "ru-everyday", "text": "По выходным здесь бывает многолю|дно."},
  {"id": "ru-everyday-03", "group": "ru-everyday", "text": "В аптеке сказали, что лекар|ство закончилось."},
  {"id": "ru-everyday-04", "group": "ru-everyday", "text": "На улице станов|ится прохладно."},
  {"id": "ru-everyday-05", "group": "ru-everyday", "text": "Вчера совсем заб|ыла про ключи."},
  {"id": "ru-everyday-06", "group": "ru-everyday", "text": "Мы доедем на общес|твенном транспорте."},
  {"id": "ru-everyday-07", "group": "ru-everyday", "text": "В холодиль|нике осталось молоко."},
  {"id": "ru-everyday-08", "group": "ru-everyday", "text": "Закрой окно, начи|нается дождь."},
  {"id": "ru-everyday-09", "group": "ru-everyday", "text": "Дети собир|аются в школу."},
  {"id": "ru-everyday-10", "group": "ru-everyday", "text": "После трени|ровки зайдём домой."},
  {"id": "ru-everyday-11", "group": "ru-everyday", "text": "На останов|ке увидел соседку."},
  {"id": "ru-everyday-12", "group": "ru-everyday", "text": "Книга лежит на подоко|ннике."},
  {"id": "ru-everyday-13", "group": "ru-everyday", "text": "Билеты можно забрать в киос|ке."},
  {"id": "ru-everyday-14", "group": "ru-everyday", "text": "По воскресеньям магаз|ин открывается позже."},
  {"id": "ru-everyday-15", "group": "ru-everyday", "text": "Эти полотен|ца надо высушить."},
  {"id": "ru-everyday-16", "group": "ru-everyday", "text": "Растения перестав|или на балкон."},
  {"id": "ru-tech-01", "group": "ru-tech", "text": "В каталоге несколько конфи|гураций для сборки."},
  {"id": "ru-tech-02", "group": "ru-tech", "text": "Описание запроса добавь в докумен|тацию."},
  {"id": "ru-tech-03", "group": "ru-tech", "text": "После переза|пуска сервис отвечал быстрее."},
  {"id": "ru-tech-04", "group": "ru-tech", "text": "Каретка остаётся в редакт|ируемом поле."},
  {"id": "ru-tech-05", "group": "ru-tech", "text": "Сборка проверяет версию завис|имости."},
  {"id": "ru-tech-06", "group": "ru-tech", "text": "Настройки сохраня|ются после закрытия окна."},
  {"id": "ru-tech-07", "group": "ru-tech", "text": "На сервере заканч|ивается память."},
  {"id": "ru-tech-08", "group": "ru-tech", "text": "Новый кэш снизил задерж|ку при повторном запросе."},
  {"id": "ru-tech-09", "group": "ru-tech", "text": "Открой меню и включи отлад|ку."},
  {"id": "ru-tech-10", "group": "ru-tech", "text": "Нужно восстан|овить предыдущую версию пакета."},
  {"id": "ru-tech-11", "group": "ru-tech", "text": "Этот обработчик получает коор|динаты окна."},
  {"id": "ru-tech-12", "group": "ru-tech", "text": "Программа не распоз|наёт новый формат."},
  {"id": "ru-tech-13", "group": "ru-tech", "text": "Проверь код на совмести|мость с предыдущей версией."},
  {"id": "ru-tech-14", "group": "ru-tech", "text": "Фильтр срабатывает для кирил|лицы и латиницы."},
  {"id": "ru-tech-15", "group": "ru-tech", "text": "В тесте неожиданно появ|ились дубликаты."},
  {"id": "ru-tech-16", "group": "ru-tech", "text": "Загрузка обнов|ления завершилась."},
  {"id": "ru-finished-01", "group": "ru-finished", "text": "Это наш дом|."},
  {"id": "ru-finished-02", "group": "ru-finished", "text": "Положи туда|, где лежит ключ."},
  {"id": "ru-finished-03", "group": "ru-finished", "text": "Включи свет| и закрой дверь."},
  {"id": "ru-finished-04", "group": "ru-finished", "text": "Увидимся утром|."},
  {"id": "ru-finished-05", "group": "ru-finished", "text": "Держи книгу правой рукой|."},
  {"id": "ru-finished-06", "group": "ru-finished", "text": "Пора менять цвет| обложки."},
  {"id": "ru-finished-07", "group": "ru-finished", "text": "Как тебе этот звук|?"},
  {"id": "ru-finished-08", "group": "ru-finished", "text": "Тут есть связь|."},
  {"id": "ru-finished-09", "group": "ru-finished", "text": "Вернусь через час|."},
  {"id": "ru-finished-10", "group": "ru-finished", "text": "Остался один шаг| до конца."},
  {"id": "ru-finished-11", "group": "ru-finished", "text": "Пришли мне свой адрес|."},
  {"id": "ru-finished-12", "group": "ru-finished", "text": "По дороге купи хлеб|."},
  {"id": "en-work-01", "group": "en-work", "text": "Please provide an estima|te by Friday."},
  {"id": "en-work-02", "group": "en-work", "text": "The fina|ncial results came in yesterday."},
  {"id": "en-work-03", "group": "en-work", "text": "I have attached the signed agreem|ent."},
  {"id": "en-work-04", "group": "en-work", "text": "We'll discuss the revised budg|et this afternoon."},
  {"id": "en-work-05", "group": "en-work", "text": "Could you forward the inv|oice to accounting?"},
  {"id": "en-work-06", "group": "en-work", "text": "The client requested a demons|tration before lunch."},
  {"id": "en-work-07", "group": "en-work", "text": "Please copy the whole departm|ent on your reply."},
  {"id": "en-work-08", "group": "en-work", "text": "The deadline has moved to Tues|day."},
  {"id": "en-work-09", "group": "en-work", "text": "She will coord|inate the handover next week."},
  {"id": "en-work-10", "group": "en-work", "text": "I'll need appro|val from our manager first."},
  {"id": "en-work-11", "group": "en-work", "text": "The minutes are ready for distri|bution."},
  {"id": "en-work-12", "group": "en-work", "text": "We can reach a comprom|ise on the dates."},
  {"id": "en-work-13", "group": "en-work", "text": "Before dispat|ching the order, check the address."},
  {"id": "en-work-14", "group": "en-work", "text": "Let me know your availab|ility for a quick call."},
  {"id": "en-work-15", "group": "en-work", "text": "Could you summar|ize the outstanding questions?"},
  {"id": "en-work-16", "group": "en-work", "text": "The report includes the complete break|down."},
  {"id": "en-everyday-01", "group": "en-everyday", "text": "I'll pick up some stra|wberries on the way home."},
  {"id": "en-everyday-02", "group": "en-everyday", "text": "It was raining when we left the restau|rant."},
  {"id": "en-everyday-03", "group": "en-everyday", "text": "Please turn off the kitchen lig|ht."},
  {"id": "en-everyday-04", "group": "en-everyday", "text": "We'll have break|fast at seven tomorrow."},
  {"id": "en-everyday-05", "group": "en-everyday", "text": "She left her umbrella in the hall|way."},
  {"id": "en-everyday-06", "group": "en-everyday", "text": "The neigh|bors were away for the weekend."},
  {"id": "en-everyday-07", "group": "en-everyday", "text": "You can borrow my bic|ycle this evening."},
  {"id": "en-everyday-08", "group": "en-everyday", "text": "The kids are waiting near the play|ground."},
  {"id": "en-everyday-09", "group": "en-everyday", "text": "We took a differ|ent route back home."},
  {"id": "en-everyday-10", "group": "en-everyday", "text": "The water was surprisingly shal|low."},
  {"id": "en-everyday-11", "group": "en-everyday", "text": "Can you move the chair closer to the win|dow?"},
  {"id": "en-everyday-12", "group": "en-everyday", "text": "There are fresh veget|ables in the fridge."},
  {"id": "en-everyday-13", "group": "en-everyday", "text": "My grandm|other taught me this recipe."},
  {"id": "en-everyday-14", "group": "en-everyday", "text": "Remember to bring your pass|port."},
  {"id": "en-everyday-15", "group": "en-everyday", "text": "The washing machine is still runn|ing."},
  {"id": "en-everyday-16", "group": "en-everyday", "text": "The shop closes ear|ly on Sundays."},
  {"id": "en-tech-01", "group": "en-tech", "text": "The command failed because of a perm|ission error."},
  {"id": "en-tech-02", "group": "en-tech", "text": "The client valida|tes the response locally."},
  {"id": "en-tech-03", "group": "en-tech", "text": "We need to insp|ect the request headers."},
  {"id": "en-tech-04", "group": "en-tech", "text": "You can change the default shortc|ut in the menu."},
  {"id": "en-tech-05", "group": "en-tech", "text": "The applic|ation keeps a local cache."},
  {"id": "en-tech-06", "group": "en-tech", "text": "The old service no longer authe|nticates this client."},
  {"id": "en-tech-07", "group": "en-tech", "text": "A bench|mark records lookup latency."},
  {"id": "en-tech-08", "group": "en-tech", "text": "The respo|nse arrives in two chunks."},
  {"id": "en-tech-09", "group": "en-tech", "text": "The input field lost foc|us after the keypress."},
  {"id": "en-tech-10", "group": "en-tech", "text": "This change preserves backw|ard compatibility."},
  {"id": "en-tech-11", "group": "en-tech", "text": "We should check the connec|tion before retrying."},
  {"id": "en-tech-12", "group": "en-tech", "text": "An invalid value trig|gers a clear error."},
  {"id": "en-tech-13", "group": "en-tech", "text": "Restart the backg|round service to apply the update."},
  {"id": "en-tech-14", "group": "en-tech", "text": "The script needs a valid execu|table path."},
  {"id": "en-tech-15", "group": "en-tech", "text": "The comp|iler printed a warning."},
  {"id": "en-tech-16", "group": "en-tech", "text": "The config contains a sepa|rate entry for each environment."},
  {"id": "en-finished-01", "group": "en-finished", "text": "It was a long day|."},
  {"id": "en-finished-02", "group": "en-finished", "text": "Please send the file|."},
  {"id": "en-finished-03", "group": "en-finished", "text": "We can see the park| from here."},
  {"id": "en-finished-04", "group": "en-finished", "text": "I will give you a call|."},
  {"id": "en-finished-05", "group": "en-finished", "text": "Keep the change|."},
  {"id": "en-finished-06", "group": "en-finished", "text": "She checked the date| twice."},
  {"id": "en-finished-07", "group": "en-finished", "text": "The light came on after dark|."},
  {"id": "en-finished-08", "group": "en-finished", "text": "He closed the gate|."},
  {"id": "en-finished-09", "group": "en-finished", "text": "We made a good start|."},
  {"id": "en-finished-10", "group": "en-finished", "text": "Leave some space| for a note."},
  {"id": "en-finished-11", "group": "en-finished", "text": "It is on the left|."},
  {"id": "en-finished-12", "group": "en-finished", "text": "I found another use| for this."}
]
